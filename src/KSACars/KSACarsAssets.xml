  <!--
    Beach buggy. The wheels, arms, coil-overs and steering wheel are separate bodies because the mod
    moves them: Ksa/Buggies.cs poses each from the springs and the steering every frame.

    +X is up from the ground, +Y forward, +Z the left side.
  -->
  <!--
    CrashTolerance is the contact pressure, in pascals, past which KSA breaks a part. A car is one
    part, so its breaking is the car's destruction, and a wheel pad clipping a rock at speed reaches
    what KSA derives from its mass. Set far past anything a contact gives.
  -->
  <Part Id="KSACars_Prefab_Buggy" CrashTolerance="1e12">

    <SubPart Id="KSACars_Buggy_Body" InstanceOf="KSACars_BuggyBody_SubPart" />

    <SubPart Id="KSACars_Buggy_WheelFL" InstanceOf="KSACars_BuggyWheelFront_SubPart">
      <Transform>
        <Position X="0.34000" Y="1.15000" Z="0.84000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_WheelFR" InstanceOf="KSACars_BuggyWheelFront_SubPart">
      <Transform>
        <Position X="0.34000" Y="1.15000" Z="-0.84000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_WheelRL" InstanceOf="KSACars_BuggyWheelRear_SubPart">
      <Transform>
        <Position X="0.40000" Y="-0.95000" Z="0.88000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_WheelRR" InstanceOf="KSACars_BuggyWheelRear_SubPart">
      <Transform>
        <Position X="0.40000" Y="-0.95000" Z="-0.88000" />
      </Transform>
    </SubPart>

    <SubPart Id="KSACars_Buggy_ArmFL" InstanceOf="KSACars_BuggyArmFL_SubPart">
      <Transform>
        <Position X="0.40000" Y="1.55000" Z="0.62000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_ArmFR" InstanceOf="KSACars_BuggyArmFR_SubPart">
      <Transform>
        <Position X="0.40000" Y="1.55000" Z="-0.62000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_ArmRL" InstanceOf="KSACars_BuggyArmRL_SubPart">
      <Transform>
        <Position X="0.44000" Y="-0.45000" Z="0.62000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_ArmRR" InstanceOf="KSACars_BuggyArmRR_SubPart">
      <Transform>
        <Position X="0.44000" Y="-0.45000" Z="-0.62000" />
      </Transform>
    </SubPart>

    <SubPart Id="KSACars_Buggy_CoilFL" InstanceOf="KSACars_BuggyCoilFL_SubPart">
      <Transform>
        <Position X="0.78000" Y="1.29000" Z="0.64000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_CoilFR" InstanceOf="KSACars_BuggyCoilFR_SubPart">
      <Transform>
        <Position X="0.78000" Y="1.29000" Z="-0.64000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_CoilRL" InstanceOf="KSACars_BuggyCoilRL_SubPart">
      <Transform>
        <Position X="0.86000" Y="-0.75000" Z="0.66000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Buggy_CoilRR" InstanceOf="KSACars_BuggyCoilRR_SubPart">
      <Transform>
        <Position X="0.86000" Y="-0.75000" Z="-0.66000" />
      </Transform>
    </SubPart>

    <SubPart Id="KSACars_Buggy_Steering" InstanceOf="KSACars_BuggySteering_SubPart">
      <Transform>
        <Position X="0.76000" Y="0.31000" Z="-0.28000" />
      </Transform>
    </SubPart>

    <SubPart Id="KSACars_Buggy_Glass" InstanceOf="KSACars_BuggyGlass_SubPart" />

    <!-- Outboard of each seat, at the tub's side: a kitten boards within a metre of its door. -->
    <SubPart Id="KSACars_BuggyDoorL" InstanceOf="KSACars_BuggyDoorL_SubPart">
      <Transform>
        <Position X="0.55000" Y="0.18000" Z="0.75000" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_BuggyDoorR" InstanceOf="KSACars_BuggyDoorR_SubPart">
      <Transform>
        <Position X="0.55000" Y="0.18000" Z="-0.75000" />
      </Transform>
    </SubPart>

    <!-- Underside attach node, at the ground plane and facing down. -->
    <Connector Id="_bgConnectorAft">
      <Transform>
        <Position X="0.00000" />
        <Rotation Z="3.14159" />
        <Scale X="2.00000" Y="2.00000" Z="2.00000" />
      </Transform>
    </Connector>

  </Part>

