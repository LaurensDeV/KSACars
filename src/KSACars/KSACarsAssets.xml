    </SubPart>
    <SubPart Id="KSACars_Eldo_WheelFR" InstanceOf="KSACars_EldoWheel_SubPart">
      <Transform>
        <Position X="0.36000" Y="1.60400" Z="-0.80900" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Eldo_WheelRL" InstanceOf="KSACars_EldoWheel_SubPart">
      <Transform>
        <Position X="0.36000" Y="-1.60400" Z="0.80750" />
      </Transform>
    </SubPart>
    <SubPart Id="KSACars_Eldo_WheelRR" InstanceOf="KSACars_EldoWheel_SubPart">
