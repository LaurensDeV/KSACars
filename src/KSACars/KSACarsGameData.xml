  <Part Id="KSACars_Prefab_F1" Modify="Patch" DisplayName="Ferrari F2004">
    <EditorTags Modify="Extend">
      <EditorTag Ref="Vehicles" />
      <EditorTag Ref="NoFaceSnapping" />
    </EditorTags>
    <Diameters Modify="Extend">
      <Diameter M="2" />
    </Diameters>
    <InertMasses Modify="Extend">

      <!--
        605 kg with its driver, low and a little rearward. The box is longer and wider than the car: each
        tyre takes out most of its own side slip every step, and with hubs 1.5 m from the middle a box the
        car's size has too little yaw inertia for four of them, so the car rocks. This is the Eldorado's
        ratio of inertia to mass, which settles.
      -->
      <SolidCuboidMass>
        <Mass Kg="579.4" />
        <LocationAsmb X="0.30" Y="-0.15" />
        <LengthX M="0.511" />
        <LengthY M="5.722" />
        <LengthZ M="2.044" />
      </SolidCuboidMass>
    </InertMasses>
    <Components Modify="Extend">
      <Control />
      <Battery>
        <MaximumCapacity J="2000" />
      </Battery>

      <!-- The rain light's switch: KSA lights the emissive lens while it is on. -->
      <PowerConsumer LightSwitch="true">
        <Consumed W="0.001" />
      </PowerConsumer>

      <!--
        A cabin, so a kitten can get out where the air is too thin to breathe: KSA fills an EVA suit
        from the cabin it is seated in, and a seat with none is refused under life support. Stocked as
        Core's Gemini is, three days a kitten, which is about 26 kg that the mass box above leaves out
        so a stocked car weighs and turns as it did. An open car's air is the sky's, hence the room.
      -->
      <Habitat Key="Cabin">
        <HabitableVolume M3="2" />
        <StorageVolume M3="0.021" />
        <LocationAsmb X="0.30" Y="-0.15" />
      </Habitat>
      <Tank Key="OxygenBottle">
        <SphericalTank>
          <LocationAsmb X="0.30" Y="-0.15" />
          <Material Ref="Aluminum.2014" Phase="Solid" />
          <OuterRadius M="0.1389" />
          <WallThickness Mm="8.3" />
          <RoleAffinity>Air</RoleAffinity>
        </SphericalTank>
      </Tank>
      <Tank Key="WaterTank">
        <SphericalTank>
          <LocationAsmb X="0.30" Y="-0.15" />
          <Material Ref="Aluminum.2014" Phase="Solid" />
          <OuterRadius M="0.1327" />
          <WallThickness Mm="1" />
          <RoleAffinity>Water</RoleAffinity>
        </SphericalTank>
      </Tank>

      <!--
        One seat. Position is the eye, 0.63 m over the seated kitten's origin: the kitten sits high and
        forward of a driver, because its head is wider than the cockpit and has to clear the rim and the
        roll hoop.
      -->
      <IVASeat Key="KSACars_F1_SeatDriver">
        <Position X="0.750" Y="0.200" Z="0.000" />
        <ForwardAxis Y="1" />
        <UpAxis X="1" />
      </IVASeat>

      <!--
        The springs hold it up; these touch only in a crash. The hull box starts 14 cm up and each
        wheel's pad the same, over springs that move 2 cm.
      -->
      <Collider Key="KSACars_F1Collider">
        <Colliders>
          <Box Key="KSACars_F1HullCollider">
            <LocationAsmb X="0.42" Y="0.20" Z="0" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="0.56" />
            <LengthY M="4.50" />
            <LengthZ M="1.36" />
          </Box>
          <Box Key="KSACars_F1PadFLCollider">
            <LocationAsmb X="0.36" Y="1.525" Z="0.735" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="0.44" />
            <LengthY M="0.50" />
            <LengthZ M="0.30" />
          </Box>
          <Box Key="KSACars_F1PadFRCollider">
            <LocationAsmb X="0.36" Y="1.525" Z="-0.735" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="0.44" />
            <LengthY M="0.50" />
            <LengthZ M="0.30" />
          </Box>
          <Box Key="KSACars_F1PadRLCollider">
            <LocationAsmb X="0.36" Y="-1.525" Z="0.7025" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="0.44" />
            <LengthY M="0.50" />
            <LengthZ M="0.30" />
          </Box>
          <Box Key="KSACars_F1PadRRCollider">
            <LocationAsmb X="0.36" Y="-1.525" Z="-0.7025" />
            <Collider2Asmb X="0" Y="0" Z="0" />
            <LengthX M="0.44" />
            <LengthY M="0.50" />
            <LengthZ M="0.30" />
          </Box>
        </Colliders>
      </Collider>
    </Components>
  </Part>

  <SubPart Id="KSACars_F1Door_SubPart" Modify="Patch">
    <Components Modify="Extend">
      <EVADoor SeatId="KSACars_F1_SeatDriver" />
    </Components>
  </SubPart>

