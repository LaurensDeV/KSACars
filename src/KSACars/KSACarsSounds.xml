<?xml version="1.0" encoding="utf-8"?>
<!--
  The cars' engines. Modelled on Core's Sounds.xml, which is the only documentation this format has.

  Each .wav is cut from a recording by a script, so it can be re-cut, with where it came from in
  tools/audio/README.md. Mono on purpose: the engine spatialises the source, and a stereo file
  arrives already mixed.
-->
<Assets>
    <!--
      The beach buggy's engine, cut by tools/buggy-sounds.py from two recordings of '74 VW Beetles.
      Ksa/BuggySound.cs plays the idle and the loaded loop together and sets their pitch and volume
      each frame, so neither declares a Pitch or a Param.
    -->
    <SpatialSoundData Id="KSACarsBuggySpatialData">
        <VolumeRange Min="6" Max="900" />
        <TwoDRange Min="2" Max="8" />
    </SpatialSoundData>

    <SoundFile Id="KSACarsBuggyStartFile" Path="Sounds/KSACars_Buggy_Start.wav" Volume="1.0"/>
    <Sound Id="KSACarsBuggyStart" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsBuggyStartFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsBuggySpatialData" />
    </Sound>

    <SoundFile Id="KSACarsBuggyIdleFile" Path="Sounds/KSACars_Buggy_Idle.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsBuggyIdle" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsBuggyIdleFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsBuggySpatialData" />
    </Sound>

    <SoundFile Id="KSACarsBuggyLoadFile" Path="Sounds/KSACars_Buggy_Load.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsBuggyLoad" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsBuggyLoadFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsBuggySpatialData" />
    </Sound>

    <SoundFile Id="KSACarsBuggyStopFile" Path="Sounds/KSACars_Buggy_Stop.wav" Volume="1.0"/>
    <Sound Id="KSACarsBuggyStop" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsBuggyStopFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsBuggySpatialData" />
    </Sound>

    <!--
      The Eldorado's engine, cut by tools/eldorado-sounds.py: the start and the idle from a 1966 Cadillac
      Coupe de Ville, the loaded loop and the key-off from a 1980 Chevrolet Impala's V8.
    -->
    <SpatialSoundData Id="KSACarsEldoSpatialData">
        <VolumeRange Min="8" Max="1200" />
        <TwoDRange Min="2" Max="9" />
    </SpatialSoundData>

    <SoundFile Id="KSACarsEldoStartFile" Path="Sounds/KSACars_Eldo_Start.wav" Volume="1.0"/>
    <Sound Id="KSACarsEldoStart" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsEldoStartFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsEldoSpatialData" />
    </Sound>

    <SoundFile Id="KSACarsEldoIdleFile" Path="Sounds/KSACars_Eldo_Idle.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsEldoIdle" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsEldoIdleFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsEldoSpatialData" />
    </Sound>

    <SoundFile Id="KSACarsEldoLoadFile" Path="Sounds/KSACars_Eldo_Load.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsEldoLoad" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsEldoLoadFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsEldoSpatialData" />
    </Sound>

    <SoundFile Id="KSACarsEldoStopFile" Path="Sounds/KSACars_Eldo_Stop.wav" Volume="1.0"/>
    <Sound Id="KSACarsEldoStop" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsEldoStopFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsEldoSpatialData" />
    </Sound>

    <!--
      The F2004's engine, made by tools/f2004-sounds.py from one recording of a 2005 Red Bull-Cosworth
      RB1's V10: the loaded loop is the recording's, and the idle, the start and the key-off are that
      note played slower. The recording is CC BY-SA 3.0, credited in README.md.
    -->
    <SpatialSoundData Id="KSACarsF1SpatialData">
        <VolumeRange Min="10" Max="2500" />
        <TwoDRange Min="2" Max="9" />
    </SpatialSoundData>

    <SoundFile Id="KSACarsF1StartFile" Path="Sounds/KSACars_F1_Start.wav" Volume="1.0"/>
    <Sound Id="KSACarsF1Start" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsF1StartFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsF1SpatialData" />
    </Sound>

    <SoundFile Id="KSACarsF1IdleFile" Path="Sounds/KSACars_F1_Idle.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsF1Idle" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsF1IdleFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsF1SpatialData" />
    </Sound>

    <SoundFile Id="KSACarsF1LoadFile" Path="Sounds/KSACars_F1_Load.wav" Volume="1.0">
        <Loop />
    </SoundFile>
    <Sound Id="KSACarsF1Load" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsF1LoadFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsF1SpatialData" />
    </Sound>

    <SoundFile Id="KSACarsF1StopFile" Path="Sounds/KSACars_F1_Stop.wav" Volume="1.0"/>
    <Sound Id="KSACarsF1Stop" Priority="115">
        <Channel Ref="ExternalChannel" />
        <SoundFiles>
            <SoundFile Ref="KSACarsF1StopFile" />
        </SoundFiles>
        <SpatialSoundData Ref="KSACarsF1SpatialData" />
    </Sound>

</Assets>
